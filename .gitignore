# =====================================================================
# 1. 大语言模型权重文件 (LLM Weights & Models)
# 【重要提示】Gitee 免费版单文件上限 100MB、单仓库上限 500MB
# 模型文件请通过魔搭社区 (ModelScope) 或网盘单独向协作同学分发，严禁提交到 Git
# =====================================================================
models/*.gguf
models/*.bin
models/*.safetensors
models/*.onnx
*.gguf
*.bin
*.safetensors
*.onnx

# 保留 Ollama 的模型构建指令模板文件
!models/Modelfile_*

# =====================================================================
# 2. 运行日志与大型调试记录 (Logs & Traces)
# =====================================================================
*.log
log.txt
*.buildlog
*.history
build.log

# =====================================================================
# 3. 本地运行时数据与测试导出 (Local Runtime Data & Exports)
# 避免团队协作时不同机器的个人日程数据与配置相互覆盖冲突
# =====================================================================
agenda_events.json
app_settings.json
theme_mode.txt
exported_ics/
scratch/

# =====================================================================
# 3.5. 敏感密钥、私钥证书与凭据配置 (Secrets, Private Keys & Credentials)
# 严禁将任何公私钥、证书、API Token 或含敏感信息的配置文件提交至版本库
# =====================================================================
# SSH 密钥与公钥 (含本地临时生成的 key 文件)
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
*.pub
/2
/2.pub
known_hosts*
authorized_keys*

# SSL/TLS 证书、私钥与签名文件
*.pem
*.key
*.pk8
*.p12
*.pfx
*.crt
*.cer
*.der
*.csr

# 环境变量与机密凭据文件
.env
.env.*
!.env.example
!.env.template
secrets/
secrets.json
secret.json
credentials.json
client_secret*.json
token.json
service-account*.json

# 移动端服务与云配置凭据
google-services.json
GoogleService-Info.plist
signing.properties
keystore.properties

# =====================================================================
# 4. Flutter / Dart 构件与依赖缓存 (Flutter / Dart / Pub)
# =====================================================================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/
.packages
doc/api/

# 符号化与混淆映射产物
app.*.symbols
app.*.map.json

# =====================================================================
# 5. Android 构建产物与私有配置 (Android Specific)
# =====================================================================
android/.gradle/
android/captures/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
**/android/app/build/
**/android/build/
.gradle/

# Android 签名密钥与私密配置
*.jks
*.keystore
key.properties

# =====================================================================
# 6. Windows 桌面构建中间文件 (Windows Desktop Ephemeral)
# =====================================================================
windows/flutter/ephemeral/
windows/runner/Debug/
windows/runner/Release/
*.obj
*.pdb
*.ilk
*.exe
*.dll

# =====================================================================
# 7. IDE 与开发工具私有配置 (IDEs & Editors)
# =====================================================================
.idea/
*.iml
*.ipr
*.iws
.vscode/
.widget_preview/

# =====================================================================
# 8. 操作系统自动生成的临时文件 (OS Generated)
# =====================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =====================================================================
# 9. 本地设计原图与图标临时素材 (Design Sources & Temporary Icons)
# =====================================================================
logo.png
assets/icon/
